<main class="dashboard">
  <h1>Organizer dashboard</h1>
  <p class="dashboard__sub">
    <p>
  <%= link_to "Verify payments (#{@submitted})", organizer_payments_path, class: "btn btn--primary" %>
  <%= link_to "Open check-in →", organizer_checkin_path, class: "btn btn--ghost" %>
</p>
  </p>

  <section class="stats" aria-label="Totals">
    <div class="stat"><span class="stat__num"><%= @paid %></span><span class="stat__label">Paid</span></div>
    <div class="stat"><span class="stat__num"><%= @pending %></span><span class="stat__label">Pending</span></div>
    <div class="stat"><span class="stat__num"><%= @submitted %></span><span class="stat__label">To verify</span></div>
    <div class="stat">
      <span class="stat__num"><%= number_with_delimiter(@revenue) %></span>
      <span class="stat__label"><%= @event.currency %> collected</span>
    </div>
    <div class="stat"><span class="stat__num"><%= @checked_in %></span><span class="stat__label">Checked in</span></div>
  </section>

  <section class="attendees">
    <h2>Attendees</h2>

    <%= form_with url: organizer_root_path, method: :get, class: "search" do %>
      <%= hidden_field_tag :status, @status if @status %>
      <%= search_field_tag :q, @query, placeholder: "Search name, phone, programme or ticket code",
                           "aria-label": "Search attendees" %>
      <button class="btn btn--primary" type="submit">Search</button>
    <% end %>

    <nav class="filters" aria-label="Filter by status">
      <%= link_to "All", organizer_root_path(q: @query.presence), class: "pill #{'pill--active' if @status.nil?}" %>
      <%= link_to "Paid", organizer_root_path(status: "paid", q: @query.presence), class: "pill #{'pill--active' if @status == 'paid'}" %>
      <%= link_to "Pending", organizer_root_path(status: "pending", q: @query.presence), class: "pill #{'pill--active' if @status == 'pending'}" %><%= link_to "To verify", organizer_root_path(status: "submitted", q: @query.presence), class: "pill #{'pill--active' if @status == 'submitted'}" %>
    </nav>

    <% if @registrations.empty? %>
      <p class="dashboard__empty">Nobody matches that yet.</p>
    <% else %>
      <div class="table-scroll">
        <table class="attendee-table">
          <thead>
            <tr>
              <th>Name</th><th>Phone</th><th>Programme</th><th>Status</th>
              <th>Code</th><th>Price</th><th>Registered</th>
            </tr>
          </thead>
          <tbody>
            <% @registrations.each do |r| %>
              <tr>
                <td>
                  <%= r.full_name %>
                  <% if r.coming_with.present? %><br><small>with <%= r.coming_with %></small><% end %>
                </td>
                <td><%= PhoneNormalizer.local(r.phone) %></td>
                <td><%= r.programme %></td>
                <td><span class="badge badge--<%= r.status %>"><%= r.status.capitalize %></span></td>
                <td><code><%= r.ticket_code %></code></td>
                <td><%= number_with_delimiter(r.price) %></td>
                <td><%= r.created_at.in_time_zone("Africa/Kigali").strftime("%d %b, %H:%M") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
      <p class="dashboard__note">
        Showing <%= @registrations.size %>
      </p>
    <% end %>
  </section>
</main>
